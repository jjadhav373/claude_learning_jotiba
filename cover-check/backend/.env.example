# Copy this file to backend/.env and fill in your local values.
# Use the password you set when installing PostgreSQL.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cover_check_dev
LINK_TOKEN_SECRET=local-dev-secret-at-least-32-characters-long
AGENT_API_KEY=dev-agent-key
NOTICE_VERSION=v1
DOC_RETENTION_DAYS=90
CORS_ORIGIN=http://localhost:5173
# Leave these empty locally: WhatsApp sends and OTP codes are printed in the API terminal instead.
# GUPSHUP_API_KEY=
# GUPSHUP_SOURCE_NUMBER=
